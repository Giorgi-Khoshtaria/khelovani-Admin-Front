  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:headed": "npx playwright test --headed",
    "test:e2e:headed:seq": "npx playwright test --headed --workers=1",
    "test:admin:auth": "npx playwright test tests/admin/auth.spec.ts --headed --workers=1",
    "test:admin:export": "npx playwright test tests/admin/export.spec.ts --headed --workers=1",
    "test:admin:menu": "npx playwright test tests/admin/menu.spec.ts --headed --workers=1",
    "test:admin:partners": "npx playwright test tests/admin/partners.spec.ts --headed --workers=1",
    "test:admin:products": "npx playwright test tests/admin/products.spec.ts --headed --workers=1",
    "test:admin:rbac": "npx playwright test tests/admin/rbac_isolation.spec.ts --headed --workers=1",
    "test:admin:roles": "npx playwright test tests/admin/roles.spec.ts --headed --workers=1",
    "test:admin:translations": "npx playwright test tests/admin/translations.spec.ts --headed --workers=1",
    "test:organizer:auth": "npx playwright test tests/organizer/auth.spec.ts --headed --workers=1",
    "test:organizer:products": "npx playwright test tests/organizer/products.spec.ts --headed --workers=1",
    "test:organizer:profile": "npx playwright test tests/organizer/profile.spec.ts --headed --workers=1",
    "test:e2e:admin": "npx playwright test tests/admin",
    "test:e2e:organizer": "npx playwright test tests/organizer",
    "test:e2e:report": "npx playwright show-report"
